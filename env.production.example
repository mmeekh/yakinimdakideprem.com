# ─────────────────────────────────────────────────────────────
# yakinimdakideprem.com production environment template
# ─────────────────────────────────────────────────────────────
# KULLANIM:
#   cp env.production.example env.production
#   Tum REPLACE_ME_* alanlarini gercek degerlerle doldur.
#
# ASLA env.production dosyasini git'e commit etme.
# .gitignore icinde zaten var.

# --- Genel ---
ENVIRONMENT=production
PORT=8000

# --- Domain ---
DOMAIN=yakinimdakideprem.com
WWW_DOMAIN=www.yakinimdakideprem.com

# --- SSL ---
SSL_EMAIL=admin@yakinimdakideprem.com
AUTO_HTTPS=true

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# --- Caching ---
CACHE_TTL=3600
RATE_LIMIT=1000

# --- Security ---
# 64+ karakter random string - uret: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=REPLACE_ME_WITH_RANDOM_64_CHARS
ALLOWED_HOSTS=yakinimdakideprem.com,www.yakinimdakideprem.com

# CORS - sadece kendi domain ve www:
CORS_ORIGINS=https://yakinimdakideprem.com,https://www.yakinimdakideprem.com

# --- Monitoring ---
LOG_LEVEL=INFO
ENABLE_METRICS=true

# --- Twitter Bot ---
# developer.twitter.com/en/portal uzerinden uret
TWITTER_MIN_MAGNITUDE=4.0
TWITTER_HASHTAGS=#bugun #deprem #sondakika
TWITTER_POLL_INTERVAL=300
TWITTER_HISTORY_FILE=/data/posted_quakes.json
TWITTER_API_KEY=REPLACE_ME
TWITTER_API_SECRET=REPLACE_ME
TWITTER_ACCESS_TOKEN=REPLACE_ME
TWITTER_ACCESS_TOKEN_SECRET=REPLACE_ME

EARTHQUAKE_API_URL=http://yakinimdakideprem-api:8000/api/earthquakes

# IndexNow API key (Bing/Yandex anlık index ping)
INDEXNOW_KEY=a9203ccaa524624d3f18968e4ce64fd20b29f7426885a18f4956d6cd3c5df63b

# City freshness worker
FRESHNESS_POLL_SECONDS=60
FRESHNESS_MIN_MAGNITUDE=3.5
FRESHNESS_HOURS_BACK=6
